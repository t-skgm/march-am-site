---
import type { Article } from '../../infra/contentful/interfaces'
import { formatDateJp } from '../../utils/date'
import birdImage from '../../assets/images/bird-silhouette-left.png'
import { Image } from 'astro:assets'
import AdminEditLink from './AdminEditLink.astro'
import TaxonomyLink from './TaxonomyLink.astro'

export interface Props {
  entry: Article
  linkMapper: (slug: string) => string
}

const {
  entry: { id, slug, title, postedAt, thumbnail, category, tags },
  linkMapper
} = Astro.props
---

<li class="card relative pt-2 mb-2 list-none">
  <div class="card-meta text-sm mb-1">
    <time datetime={postedAt.toISOString()}>{formatDateJp(postedAt)}</time>
    <span class="mobile-category">
      <TaxonomyLink label={category} kind="category" />
    </span>
  </div>
  {thumbnail != null ? (
    <div class="thumbnail">
      {/* タイトルが直後にあるため装飾扱い */}
      <img src={thumbnail} alt="" loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="thumbnail-placeholder" aria-hidden="true">
      <Image src={birdImage} alt="" />
    </div>
  )}
  <h2 class="card-title">
    <a href={linkMapper(slug)} class="card-link">
      {title}
    </a>
  </h2>
  <div class="card-tags relative z-10 flex flex-wrap gap-2 mt-2">
    <span class="desktop-category">
      <TaxonomyLink label={category} kind="category" />
    </span>
    {tags?.map((tag) => (
      <TaxonomyLink label={tag} kind="tag" />
    ))}
    <AdminEditLink entryId={id} class="relative z-10" />
  </div>
</li>

<style>
  @reference '../../styles/global.css';

  .thumbnail,
  .thumbnail-placeholder {
    @apply h-52 w-full flex flex-col items-center justify-center bg-maccha rounded-lg;
  }

  @media (min-width: 1024px) {
    .thumbnail,
    .thumbnail-placeholder {
      height: 23rem;
    }
  }

  .thumbnail img {
    @apply h-full w-full object-cover rounded-lg;
  }

  .thumbnail-placeholder img {
    max-height: 60%;
    width: auto;
  }

  .card-title {
    @apply text-base font-bold my-1 leading-normal tracking-normal;
    font-family: inherit;
  }

  .card-link {
    @apply font-bold no-underline;
  }

  /* カード全体をクリック可能にする */
  .card-link::after {
    @apply absolute inset-0 rounded-lg;
    content: '';
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: 2px solid var(--color-maccha-dark);
    outline-offset: 2px;
  }

  /* 疑似要素 ::after のホバーも .card-link のホバーとして扱われるため、タグ等のホバー時は反応しない */
  .card-link:hover {
    @apply text-maccha-dark underline;
  }

  .mobile-category {
    display: none;
  }

  @media (max-width: 1023px) {
    .card {
      padding: 24px 0 28px;
      margin: 0;
      border-bottom: 1px solid #4a474020;
    }

    .card:first-child {
      padding-top: 8px;
    }

    .thumbnail-placeholder,
    .desktop-category {
      display: none;
    }

    .card-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
      font-size: 12px;
    }

    .card-meta time {
      color: #68665e;
      font-variant-numeric: tabular-nums;
    }

    .mobile-category {
      display: inline-flex;
    }

    .thumbnail {
      height: auto;
      aspect-ratio: 16 / 10;
      margin-bottom: 14px;
    }

    .card-title {
      font-size: 18px;
      line-height: 1.65;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .card-tags {
      gap: 6px;
      margin-top: 8px;
    }
  }
</style>
