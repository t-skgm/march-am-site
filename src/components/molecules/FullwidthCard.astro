---
import { routes } from '../../constants/routes'
import type { Article } from '../../infra/contentful/interfaces'
import { formatDateJp } from '../../utils/date'
import birdImage from '../../assets/images/bird-silhouette-left.png'
import { Image } from 'astro:assets'
import AdminEditLink from './AdminEditLink.astro'

export interface Props {
  entry: Article
  linkMapper: (slug: string) => string
}

const {
  entry: { id, slug, title, postedAt, thumbnail, category, tags },
  linkMapper
} = Astro.props
---

<li class="card relative py-2 list-none">
  <div class="text-sm mb-1">
    <time datetime={postedAt.toISOString()}>{formatDateJp(postedAt)}</time>
  </div>
  {
    thumbnail != null ? (
      <div class="thumbnail">
        {/* タイトルが直後にあるため装飾扱い */}
        <img src={thumbnail} alt="" loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="thumbnail-placeholder" aria-hidden="true">
        <Image src={birdImage} alt="" />
      </div>
    )
  }
  <h2 class="card-title">
    <a href={linkMapper(slug)} class="card-link">{title}</a>
  </h2>
  <div class="relative z-10 flex flex-wrap gap-2 mt-2">
    <a
      href={routes.article.category.page(category)}
      class="text-sm uppercase no-underline hover:underline bg-maccha-dark text-greenlite px-2 py-1"
      >{category}</a
    >
    {
      tags?.map((tag) => (
        <a
          href={routes.article.tag.page(tag)}
          class="text-sm text-maccha-dark no-underline hover:underline border-maccha-dark border rounded-3xl px-2 py-1"
        >
          {tag}
        </a>
      ))
    }
    <AdminEditLink entryId={id} />
  </div>
</li>

<style>
  @reference '../../styles/global.css';

  .thumbnail,
  .thumbnail-placeholder {
    @apply h-52 w-full flex flex-col items-center justify-center bg-maccha rounded-lg;
  }

  @media (min-width: 1024px) {
    .thumbnail,
    .thumbnail-placeholder {
      height: 23rem;
    }
  }

  .thumbnail img {
    @apply h-full w-full object-cover rounded-lg;
  }

  .thumbnail-placeholder img {
    max-height: 60%;
    width: auto;
  }

  .card-title {
    @apply text-base font-bold my-1 leading-normal tracking-normal;
    font-family: inherit;
  }

  .card-link {
    @apply font-bold no-underline;
  }

  /* カード全体をクリック可能にする */
  .card-link::after {
    @apply absolute inset-0 rounded-lg;
    content: '';
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: 2px solid var(--color-maccha-dark);
    outline-offset: 2px;
  }

  .card:hover .card-link {
    @apply text-maccha-dark underline;
  }
</style>
