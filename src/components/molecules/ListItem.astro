---
import { formatDateJp } from '../../utils/date'
import AdminEditLink from './AdminEditLink.astro'

export interface Props {
  title: string
  href: string
  date: Date
  entryId?: string
}

const { href, title, date, entryId } = Astro.props
---

<li class="py-2 list-none">
  <a href={href} class="no-underline hover:underline">
    <div class="font-bold mb-1">{title}</div>
    <div class="text-sm text-slate-500">
      posted at <time>{formatDateJp(date)}</time>
    </div>
  </a>
  {entryId != null && <AdminEditLink entryId={entryId} />}
</li>
