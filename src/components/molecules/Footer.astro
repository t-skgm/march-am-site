---
import { routes } from '../../constants/routes'
import { site } from '../../constants/site'

export type Props = { isTop?: boolean }
---

<footer>
  <div class="footer-inner">
    <nav aria-label="サイトナビゲーション">
      <ul class="primary-links">
        <li>
          <a href={routes.index}>Top</a>
        </li>
        <li>
          <a href={routes.article.index}>Article</a>
        </li>
        <li>
          <a href={routes.about}>About</a>
        </li>
      </ul>
      <ul class="browse-links">
        <li>
          <a href={routes.article.category.index}>Category</a>
        </li>
        <li>
          <a href={routes.article.tag.index}>Tag</a>
        </li>
      </ul>
    </nav>
    <ul class="sns">
      <li>
        <a
          class="sns-icon sns-x"
          href={`https://x.com/${site.author.twitter}`}
          target="_blank"
          rel="noopener"
        >
          X: @march_am_
        </a>
      </li>
      <li>
        <a
          class="sns-icon sns-apple"
          href={`https://music.apple.com/profile/${site.author.appleMusic}`}
          target="_blank"
          rel="noopener"
        >
          Apple Music: march-am
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  @reference '../../styles/global.css';

  footer {
    margin: 0 10px;
    background: #fbf3b266;
    border-top: 1px solid #4a474020;
  }
  .footer-inner {
    max-width: 660px;
    margin: 0 auto;
    padding: 28px 14px 32px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .primary-links {
    gap: 28px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-family: 'Lora', serif;
    font-weight: 600;
    font-style: italic;
    font-size: 18px;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .browse-links {
    gap: 24px;
    margin-top: 4px;
  }
  .browse-links a {
    font-size: 14px;
    color: var(--color-maccha-dark);
  }
  .sns {
    border-top: 1px solid #4a474020;
    padding-top: 20px;
    margin-top: 20px;
    gap: 24px;
  }
  .sns-icon {
    display: block;
    font-size: 0;
    width: 44px;
    height: 44px;
  }
  .sns-x {
    background-color: #4a4740;
    mask: url(../../assets/images/icons/logo_x.svg) center / 24px no-repeat;
  }
  .sns-apple {
    background: url(../../assets/images/icons/logo_apple.svg) center / 32px no-repeat;
  }
  @media (min-width: 1024px) {
    footer {
      margin-left: 300px;
      margin-right: 250px;
    }
    .footer-inner {
      padding: 40px;
    }
  }
</style>
