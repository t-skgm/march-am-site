---
import { routes } from '../../constants/routes'

interface Props {
  label: string
  kind: 'category' | 'tag'
  class?: string
}

const { label, kind, class: className } = Astro.props
const href =
  kind === 'category' ? routes.article.category.page(label) : routes.article.tag.page(label)
---

<a href={href} class:list={['taxonomy-link', kind, className]}>
  {label}
</a>

<style>
  .taxonomy-link {
    display: inline-flex;
    position: relative;
    z-index: 10;
    align-items: center;
    min-height: 28px;
    max-width: 100%;
    padding: 2px 9px;
    color: var(--color-maccha-dark);
    font-size: 12px;
    line-height: 1.5;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .taxonomy-link:hover {
    text-decoration: underline;
  }

  .category {
    background: #76917115;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tag {
    border: 1px solid var(--color-maccha-dark);
    border-radius: 999px;
  }
</style>
