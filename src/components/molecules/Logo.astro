---
import { routes } from '../../constants/routes'
import logo from '../../assets/images/logo.svg'
import { Image } from 'astro:assets'
---

<nav class="logo">
  <a href={routes.index}>
    <Image src={logo} width="80" alt="march-am トップへ" />
  </a>
</nav>

<style>
  @reference '../../styles/global.css';

  .logo {
    @apply absolute;
    top: theme(spacing.4);
    left: -10px;
  }

  .logo img {
    width: 55px;
  }

  @media (max-width: 1023px) {
    .logo {
      position: relative;
      top: auto;
      left: auto;
      margin: 0 24px;
      height: 88px;
      border-bottom: 1px solid #4a474020;
    }

    .logo a {
      display: block;
      position: relative;
      width: 164px;
      height: 76px;
    }

    .logo img {
      position: absolute;
      width: 34px;
      height: auto;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(90deg);
      filter: brightness(0) saturate(100%) invert(40%) sepia(13%) saturate(805%) hue-rotate(61deg)
        brightness(93%) contrast(87%) drop-shadow(0.4px 0 0 #56704f) drop-shadow(-0.4px 0 0 #56704f)
        drop-shadow(0 0.3px 0 #56704f);
    }
  }

  @media (min-width: 1024px) {
    .logo {
      width: 80px;
      top: theme(spacing.16);
      left: theme(spacing.48);
    }

    .logo img {
      width: 80px;
    }
  }
</style>
