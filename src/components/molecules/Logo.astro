---
import { routes } from '../../constants/routes'
import logo from '../../assets/images/logo.svg'
import { Image } from 'astro:assets'
---

<nav class="logo">
  <a href={routes.index}>
    <Image src={logo} width="80" alt="march-am トップへ" />
  </a>
</nav>

<style>
  @reference '../../styles/global.css';

  .logo {
    @apply absolute;
    top: theme(spacing.4);
    left: -10px;
  }

  .logo img {
    width: 55px;
  }

  /* スマホ幅では左の帯が狭く本文と重なってしまうため非表示にする。
     トップへの導線は back-to-top リンクやフッターの Top リンクで確保している。 */
  @media (max-width: 1023px) {
    .logo {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .logo {
      width: 80px;
      top: theme(spacing.16);
      left: theme(spacing.48);
    }

    .logo img {
      width: 80px;
    }
  }
</style>
