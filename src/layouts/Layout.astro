---
import '../styles/global.css'
import '../styles/remark-link-card.css'
// Lora は実際の使用箇所（h1: 700 normal / back-to-top・back-to: 400 italic / フッターnav: 600 italic）
// に合わせて必要なウェイト・スタイルのみを読み込み、ブラウザによる合成(faux)イタリック・ボールドを避ける
import '@fontsource/lora/400-italic.css'
import '@fontsource/lora/600-italic.css'
import '@fontsource/lora/700.css'
import type { Props as SEOProps } from 'astro-seo'
import { SEO } from 'astro-seo'
import Logo from '../components/molecules/Logo.astro'
import Footer from '../components/molecules/Footer.astro'
import GA from '../components/molecules/GoogleAnalytics.astro'
import { SearchModal } from '../features/search'
import { site } from '../constants/site'
import { getToken } from '../utils/getTokenNode'

export interface Props {
  isTop?: boolean
  title?: string
  /** ページ固有のmeta description。未指定の場合はsite.descriptionを使用する */
  description?: string | undefined
  frontmatter?: Record<string, unknown>
  /** canpnicalのPath部分を上書きしたい場合 */
  canonicalPath?: string | undefined
  overrideSEOProps?: Partial<SEOProps>
  socialImageURL?: string | undefined
  /** pagefindのインデックス対象から除外する場合true */
  noPagefindIndex?: boolean
}

const {
  isTop = false,
  title,
  description,
  frontmatter,
  canonicalPath,
  overrideSEOProps,
  noPagefindIndex = false
} = Astro.props

const pageDescription = description != null && description.length > 0 ? description : site.description

const articleTitle = (title ?? frontmatter?.title) as string | undefined
const pageTitle = (divider: string) =>
  articleTitle != null ? `${articleTitle} ${divider} ${site.title}` : site.title

const baseUrl = Astro.site ?? Astro.url
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, baseUrl)
const encryptionSecret = import.meta.env.ENCRYPTION_SECRET
const ogpGenerateURL = import.meta.env.PUBLIC_OGP_GENERATE_URL

const getOgpUrl = (text: string): string | undefined => {
  if (encryptionSecret == null || encryptionSecret.length === 0) return
  if (ogpGenerateURL == null || ogpGenerateURL.length === 0) return

  const token = getToken(encryptionSecret, { text })
  return `${ogpGenerateURL}/og?i=${token}&text=${encodeURIComponent(text)}`
}

const socialImageURL: string = (() => {
  if (Astro.props.socialImageURL != null) return Astro.props.socialImageURL
  if (articleTitle != null) {
    const ogpUrl = getOgpUrl(articleTitle)
    if (ogpUrl != null) return ogpUrl
  }
  return new URL('/assets/ogp_site.jpg', baseUrl).toString()
})()
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <SEO
      title={pageTitle('-')}
      description={pageDescription}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          image: socialImageURL,
          title: pageTitle('|'),
          type: 'blog'
        },
        optional: {
          description: pageDescription
        },
        image: {
          alt: 'Image of this site, ' + site.title
        }
      }}
      twitter={{
        card: 'summary_large_image',
        site: `@${site.author.twitter}`,
        title: pageTitle('|'),
        description: pageDescription,
        image: socialImageURL,
        imageAlt: 'Image of this site, ' + site.title
      }}
      extend={{
        link: [
          { rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml' },
          {
            rel: 'alternate',
            type: 'application/rss+xml',
            href: '/feed',
            title: `${site.title} feed`
          }
        ]
      }}
      {...overrideSEOProps}
    />
    <GA gtagId={import.meta.env.PUBLIC_GA_TRACKING_ID} />
  </head>

  <body class:list={{ 'body-top': isTop }}>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:shadow"
      >本文へスキップ</a
    >
    <Logo />
    <SearchModal client:load />
    <!-- <Header /> -->
    <div
      id="content"
      tabindex="-1"
      class:list={['content', { 'content-top': isTop }]}
      data-pagefind-body={!noPagefindIndex || undefined}
    >
      <slot />
    </div>
    <Footer isTop={isTop} />

    <script>
      import { revealAdminLinksIfAdmin } from '../features/admin/revealAdminLinks'

      revealAdminLinksIfAdmin()
    </script>

    <style>
      @reference '../styles/global.css';

      body {
        background:
          repeat-y 0 / 50px url(../assets/images/back_gr.jpg),
          repeat-y right 0% / 12px url(../assets/images/back_or.jpg);
        background-color: #fff;
      }

      .content {
        @apply px-2 mx-3;
        background-color: rgb(247, 248, 247, 0.85);
        padding-bottom: 10rem;
      }

      /* スキップリンクによるフォーカス移動先。tabindex=-1 のフォーカスリングは不要 */
      .content:focus {
        outline: none;
      }

      /* Bird. */
      .content::after {
        @apply block fixed;
        content: '';
        bottom: 12px;
        left: 1px;
        width: 60px;
        height: 60px;
        transform: scale(-1, 1);
        background: no-repeat 0 / 60px url(../assets/images/bird_s.png);
      }

      /* less than lg */
      @media (max-width: 1023px) {
        .body-top {
          background:
            repeat-y 0 / 50px url(../assets/images/back_gr.jpg),
            repeat-y right 0% / 38px url(../assets/images/back_or.jpg);
        }

        .content-top {
          @apply pl-4 pt-6;
          margin: 0 50px 0 40px;
        }

        /* スマホ幅では本文末尾（Main.astro の main::after）の鳥と重複するため非表示 */
        .content::after {
          display: none;
        }
      }

      @media (min-width: 1024px) {
        body {
          background:
            repeat-y 0 / 300px url(../assets/images/back_gr.jpg),
            repeat-y right 0 / 250px url(../assets/images/back_or.jpg);
        }

        .content {
          @apply px-10 pt-10 my-0;
          min-height: calc(100vh - 16rem);
          margin-left: 300px;
          margin-right: 250px;
        }

        /* Bird. */
        .content::after {
          bottom: 60px;
          left: 60px;
          width: 120px;
          height: 120px;
          transform: scale(-1, 1);
          background-size: 120px;
        }
      }
    </style>
  </body>
</html>
