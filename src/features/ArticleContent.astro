---
import { routes } from '../constants/routes'
import type { Article } from '../infra/contentful/interfaces'
import { formatDateJp } from '../utils/date'
import AdminEditLink from '../components/molecules/AdminEditLink.astro'
import TaxonomyLink from '../components/molecules/TaxonomyLink.astro'

export type Props = {
  entry: Article
}

const { entry } = Astro.props
const { id, title, postedAt, category, tags, thumbnail, slug, content } = entry
---

<header data-pagefind-ignore>
  {thumbnail != null && <img src={thumbnail} alt={`Eye catch of ${title}`} class="mb-8" />}
  <h1 class="content-header" data-pagefind-meta="title">
    <a href={routes.article.slug(slug)}>{title}</a>
  </h1>
</header>

<div class="article-details" data-pagefind-ignore>
  <div class="article-meta">
    <time datetime={postedAt.toISOString()}>{formatDateJp(postedAt)}</time>
    <TaxonomyLink label={category} kind="category" />
    <AdminEditLink entryId={id} />
  </div>
  {tags != null && tags.length > 0 && (
    <div class="article-tag-list">
      {tags.map((tag) => (
        <TaxonomyLink label={tag} kind="tag" />
      ))}
    </div>
  )}
</div>

<article class="post-content" set:html={content} />

<style is:global>
  @reference '../styles/global.css';

  .content-header {
    @apply text-2xl font-bold wrap-anywhere;
    font-feature-settings: 'halt';
  }

  .post-content {
    display: flow-root;
    font-feature-settings: 'halt';

    > :first-child {
      margin-top: 0;
    }

    ul,
    ol {
      @apply mr-0 pr-0;
    }

    ul ol,
    ol ul,
    ul ul {
      margin: 0;
    }

    img {
      @apply h-auto max-w-full;
    }

    /* iframe: YouTube */
    iframe.youtube,
    iframe[src^='https://www.youtube.com'] {
      @apply h-full max-w-full;
      aspect-ratio: 16 / 9;
    }

    iframe[src^='https://bandcamp.com/'] {
      @apply my-6;
    }
  }

  /* 一覧と共通のメタデータ・タグを使用する。 */
  .article-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 24px 0 32px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 12px;
  }

  .article-meta time {
    color: #68665e;
    font-variant-numeric: tabular-nums;
  }

  .article-tag-list {
    @apply flex flex-wrap;
    gap: 8px;
    margin: 0;
  }
</style>
