---
import Layout from '../../../layouts/Layout.astro'
import Main from '../../../components/molecules/Main.astro'
import { routes } from '../../../constants/routes'
import { cleanPathParam } from '../../../utils/cleanPathParam'
import { normalizeTag } from '../../../infra/contentful/common'
import { fetchArticleCategories, fetchArticleEntries } from '../../../infra/contentful/article'
import '../../../styles/global.css'

const [categories, entries] = await Promise.all([fetchArticleCategories(), fetchArticleEntries()])

const categoryCounts = categories.map((category) => ({
  category,
  count: entries.filter((e) => normalizeTag(e.category) === category).length
}))

const title = 'Category: All'
---

<Layout title={title} noPagefindIndex>
  <Main backTo={routes.article.index}>
    <h1>{title}</h1>
    <ul>
      {
        categoryCounts.map(({ category, count }) => (
          <li>
            <a href={routes.article.category.page(cleanPathParam(category), 1)}>
              {category} <span class="text-sm text-maccha-dark">({count})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
</Layout>
