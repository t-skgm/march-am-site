{
  "name": "march-am-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "run-p 'dev:pagefind' 'dev:web'",
    "dev:web": "astro dev",
    "dev:pagefind": "pagefind --serve --site dist --output-subdir ../pagefind",
    "dev:fn": "wrangler pages dev --compatibility-date 2023-05-18 -- pnpm dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "astro": "astro",
    "sync": "astro sync",
    "lint": "oxlint src",
    "fmt:check": "prettier src/",
    "fmt": "prettier --write src/",
    "test": "vitest",
    "typecheck": "astro check && tsc -p . --noEmit",
    "ncu": "npx -p npm-check-updates  -c \"ncu\"",
    "ncu-u": "npx -p npm-check-updates  -c \"ncu -u\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/pages-plugin-vercel-og": "^0.1.2",
    "@contentful/rich-text-html-renderer": "^17.2.3",
    "@fontsource/lora": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "astro-seo": "1.2.0",
    "contentful": "^11.12.10",
    "dayjs": "^1.11.23",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-toc": "^7.1.0",
    "patch-package": "8.0.1",
    "preact": "^10.29.8",
    "react": "^19.3.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-toc": "9.0.0",
    "remeda": "^2.50.0",
    "sanitize-html": "2.17.7",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "5.20260918.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "contentful-management": "^12.17.0",
    "dotenv": "^18.0.0",
    "front-matter": "4.0.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.83.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "unist-util-visit": "5.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.3"
  }
}
